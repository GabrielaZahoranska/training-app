<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="form-section">
  <h1>New Workout</h1>
  <form class="app-form" action="/workouts" method="POST">
    <label for="title">Workout Title</label>
    <input id="title" name="title" type="text" required />

    <label for="workoutDate">Date</label>
    <input id="workoutDate" name="workoutDate" type="date" required />

    <label for="duration">Duration (minutes)</label>
    <input id="duration" name="duration" type="number" min="1" required />

    <label for="focus">Focus Area</label>
    <input id="focus" name="focus" type="text" required />

    <label for="intensity">Intensity</label>
    <select id="intensity" name="intensity" required>
      <option value="">Select intensity</option>
      <option value="Low">Low</option>
      <option value="Moderate">Moderate</option>
      <option value="High">High</option>
    </select>

    <label for="notes">Notes</label>
    <textarea id="notes" name="notes" rows="4"></textarea>

    <button class="btn" type="submit">Create Workout</button>
  </form>
</section>

<%- include('../partials/footer') %>
