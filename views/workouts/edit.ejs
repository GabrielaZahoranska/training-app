<%- include('../partials/head') %>
<%- include('../partials/header') %>

<section class="form-section">
  <h1>Edit Workout</h1>
  <form class="app-form" action="/workouts/<%= workout._id %>?_method=PUT" method="POST">
    <label for="title">Workout Title</label>
    <input id="title" name="title" type="text" required value="<%= workout.title %>" />

    <label for="workoutDate">Date</label>
    <input
      id="workoutDate"
      name="workoutDate"
      type="date"
      required
      value="<%= workout.workoutDate.toISOString().slice(0, 10) %>"
    />

    <label for="duration">Duration (minutes)</label>
    <input id="duration" name="duration" type="number" min="1" required value="<%= workout.duration %>" />

    <label for="focus">Focus Area</label>
    <input id="focus" name="focus" type="text" required value="<%= workout.focus %>" />

    <label for="intensity">Intensity</label>
    <select id="intensity" name="intensity" required>
      <option value="Low" <%= workout.intensity === 'Low' ? 'selected' : '' %>>Low</option>
      <option value="Moderate" <%= workout.intensity === 'Moderate' ? 'selected' : '' %>>Moderate</option>
      <option value="High" <%= workout.intensity === 'High' ? 'selected' : '' %>>High</option>
    </select>

    <label for="notes">Notes</label>
    <textarea id="notes" name="notes" rows="4"><%= workout.notes %></textarea>

    <button class="btn" type="submit">Save Changes</button>
  </form>
</section>

<%- include('../partials/footer') %>
